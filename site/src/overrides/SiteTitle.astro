---
/**
 * 사이트 제목("고소·피소 가이드") 옆에 작은 서명을 인라인으로 표시.
 * 흰색은 다크모드 헤더에서 또렷, 라이트모드에선 거의 안 보이는 워터마크 톤.
 */
import Default from "@astrojs/starlight/components/SiteTitle.astro";
---

<span class="site-title-wrap">
  <Default><slot /></Default>
  <span class="site-byline" aria-hidden="true">by kim donghyeon</span>
</span>

<style>
  .site-title-wrap {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
  }
  .site-byline {
    font-size: 10px;
    font-weight: 400;
    color: #ffffff;
    letter-spacing: 0.02em;
    user-select: none;
    white-space: nowrap;
  }
  /* 좁은 화면에서는 byline 숨김 (사이트 타이틀이 줄어들어야 함) */
  @media (max-width: 30rem) {
    .site-byline {
      display: none;
    }
  }
</style>
