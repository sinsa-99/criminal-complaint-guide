---
/**
 * 우측 하단 고정 서명. fixed position이라 스크롤해도 따라옴.
 * 반투명 어두운 배경 + 흰 글씨 → 라이트/다크 모드 둘 다 보임.
 */
---

<div class="corner-signature" aria-hidden="true">by kim donghyeon</div>

<style>
  .corner-signature {
    position: fixed;
    right: 12px;
    bottom: 12px;
    z-index: 50;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 999px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    pointer-events: none;
    user-select: none;
    font-family: var(--sl-font);
  }
  /* 인쇄 시에는 숨김 */
  @media print {
    .corner-signature {
      display: none;
    }
  }
</style>
